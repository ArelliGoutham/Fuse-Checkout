{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "OfferForge",
  "colors": {
    "primary": "#F59E0B",
    "light": "#FBBF24",
    "dark": "#D97706"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Sora",
    "weight": 400
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "guides/introduction",
              "guides/quickstart",
              "guides/authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "guides/offers",
              "guides/rules",
              "guides/stacking",
              "guides/products"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://offerforge.io"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/ArelliGoutham/OfferForge"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://offerforge.io/signup"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ArelliGoutham/OfferForge"
    }
  }
}

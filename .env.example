# MongoDB connection string for local development
MONGO_URI=mongodb://offerforge:offerforge@localhost:27017/fuse?authSource=admin

# Brand configuration
BRAND_NAME=OfferForge
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#4F46E5
BRAND_SUPPORT_EMAIL=support@offerforge.io
BRAND_DOMAIN=offerforge.io

# Server
PORT=3000
NODE_ENV=development

# Order ID generation
ORDER_ID_PREFIX=FUSE

# AES-256 encryption key for PG credentials (must be 32 bytes)
ENCRYPTION_KEY=fuse-encryption-key-change-me-32

# PG Health Monitor — anomaly detection thresholds
ALERT_CHECK_INTERVAL_MS=300000
ALERT_SUCCESS_RATE_THRESHOLD=90
ALERT_LATENCY_THRESHOLD_MS=5000
ALERT_FAILURE_RATE_THRESHOLD=20
ALERT_DOWNTIME_MINUTES=30

# PG Health Monitor — alert cleanup
ALERT_RETENTION_DAYS=30
ALERT_CLEANUP_CRON_MS=86400000
